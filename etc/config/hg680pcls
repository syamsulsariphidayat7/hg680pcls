config hg680pcls 'settings'
    option ping_targets 'graph.instagram.com'
    option interval '5'
    option power_mode 'online'
    option lan_mode 'heart'
    # LED USB (pin 518 = LED indikator USB, tunggal): off | on | heart | disko
    # Di sebagian unit, pin ini justru dipakai untuk mengendalikan kipas USB
    # (pilih Nyala/Mati; JANGAN Detak/Disko untuk kipas).
    option status_mode 'heart'
    option status_pin '518'
    # Nomor pin lain bisa dioverride bila board revisinya beda, contoh:
    # option power_pin_on '521'
    # option power_pin_off '517'
    # option lan_pin_on '547'
    # option lan_pin_off '548'
