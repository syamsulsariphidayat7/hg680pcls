#!/bin/sh

# Nomor pin default. Bisa dioverride lewat UCI hg680pcls.settings.*
# (mis. `uci set hg680pcls.settings.status_pin=519`) untuk board revisi lain.
uget() {
    local v
    v=$(uci -q get "hg680pcls.settings.$1" 2>/dev/null)
    [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$2"
}

# GPIO pin POWER (dua warna: hijau/merah)
PIN_POWER_ON="$(uget power_pin_on 521)"
PIN_POWER_OFF="$(uget power_pin_off 517)"
# GPIO pin LAN
PIN_LAN_ON="$(uget lan_pin_on 547)"
PIN_LAN_OFF="$(uget lan_pin_off 548)"
# GPIO pin STATUS (LED tunggal, mis. LED IR) — mode: off/on/heart/disko
PIN_STATUS="$(uget status_pin 518)"

PID_DIR="/tmp/hg680p_led"
mkdir -p "$PID_DIR"

# ========== GPIO CONTROL ==========
set_gpio() {
    local pin="$1" val="$2"
    [ ! -d "/sys/class/gpio/gpio${pin}" ] && printf "%s" "$pin" > /sys/class/gpio/export 2>/dev/null || true
    sleep 0.02
    printf "out" > "/sys/class/gpio/gpio${pin}/direction" 2>/dev/null || true
    printf "%s" "$val" > "/sys/class/gpio/gpio${pin}/value" 2>/dev/null || true
}

# Pin kedua boleh kosong (LED tunggal): yang kosong dilewati.
reset_gpio() {
    [ -n "$1" ] && set_gpio "$1" 0
    [ -n "$2" ] && set_gpio "$2" 0
    true
}

# Sapu semua proses pola LED yang masih hidup (termasuk yang tak tercatat di PID file)
# Dipakai untuk mencegah pola "bertumpuk" saat mode diganti / service di-restart.
kill_led_procs() {
    for d in /proc/[0-9]*; do
        pid="${d#/proc/}"
        [ "$pid" = "$$" ] && continue
        [ -r "$d/cmdline" ] || continue
        cmd=$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null)
        case "$cmd" in
            "/bin/sh /usr/bin/hg680pcl power "*|"/bin/sh /usr/bin/hg680pcl lan "*|"/bin/sh /usr/bin/hg680pcl status "*)
                kill "$pid" 2>/dev/null
                ;;
        esac
    done
}

# ========== PATTERN ENGINE ==========
# Format step: "PIN_ON:PIN_OFF:DURATION" (PIN_OFF diabaikan bila kosong)
run_pattern() {
    local pin_on="$1" pin_off="$2"; shift 2
    trap "reset_gpio \"$pin_on\" \"$pin_off\"; exit" TERM INT

    while true; do
        for step in "$@"; do
            IFS=: read v_on v_off dur <<EOF
$step
EOF
            set_gpio "$pin_on" "$v_on"
            [ -n "$pin_off" ] && set_gpio "$pin_off" "$v_off"
            sleep "$dur"
        done
    done
}

# ========== MODES (LED dua warna: power & lan) ==========
mode_offline() {  # kedip pin OFF (merah)
    run_pattern "$1" "$2" \
        "0:0:0.5" \
        "0:1:0.5"
}
mode_online() {   # kedip pin ON (hijau), pola sama seperti offline
    run_pattern "$1" "$2" \
        "1:0:0.5" \
        "0:0:0.5"
}
mode_heart() {    # loop mati → kuning → hijau
    run_pattern "$1" "$2" \
        "0:0:0.3" \
        "1:1:0.2" \
        "1:0:0.3"
}
mode_disko() {    # loop mati → kuning → hijau
    run_pattern "$1" "$2" \
        "0:0:0.1" \
        "1:1:0.1" \
        "1:0:0.1"
}

# ========== MODES (LED tunggal: status) ==========
mode_heart_single() {  # dua kedip cepat lalu jeda (detak)
    run_pattern "$1" "" \
        "1::0.12" \
        "0::0.12" \
        "1::0.12" \
        "0::1.0"
}
mode_disko_single() {  # kedip cepat
    run_pattern "$1" "" \
        "1::0.09" \
        "0::0.09"
}

# Tunggu proses benar-benar keluar (maks ~0,5 detik). Penting: trap di run_pattern
# me-reset pin saat keluar — kalau tidak ditunggu, nilainya bisa menimpa nilai
# baru yang baru saja ditulis untuk mode steady (on/off).
wait_gone() {
    local p="$1" i=0
    [ -n "$p" ] || return 0
    while [ -d "/proc/$p" ] && [ "$i" -lt 25 ]; do
        sleep 0.02
        i=$((i + 1))
    done
    true
}

# ========== MODE HANDLER ==========
stop_mode() {
    local name="$1"
    # catatan: JANGAN gabung jadi satu `local` — ${name} belum tentu sudah terisi
    # di shell yang mengevaluasi RHS lebih dulu (dash), akibatnya PID file tak ketemu.
    local pid_file="$PID_DIR/${name}.pid"
    if [ -f "$pid_file" ]; then
        local p c
        p=$(cat "$pid_file" 2>/dev/null)
        c=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)
        # hanya bunuh kalau PID itu memang proses hg680pcl (hindari PID basi/terpakai ulang)
        case "$c" in
            *hg680pcl*)
                kill "$p" 2>/dev/null
                wait_gone "$p"
                ;;
        esac
        rm -f "$pid_file"
    fi
    case "$name" in
        power)  reset_gpio "$PIN_POWER_ON" "$PIN_POWER_OFF" ;;
        lan)    reset_gpio "$PIN_LAN_ON" "$PIN_LAN_OFF" ;;
        status) reset_gpio "$PIN_STATUS" ;;
    esac
}

start_mode() {
    local name="$1" mode="$2" pin_on="$3" pin_off="$4"
    stop_mode "$name"

    case "$mode" in
        offline)
            mode_offline "$pin_on" "$pin_off" >/dev/null 2>&1 &
            echo $! > "$PID_DIR/${name}.pid"
            ;;
        online)
            mode_online "$pin_on" "$pin_off" >/dev/null 2>&1 &
            echo $! > "$PID_DIR/${name}.pid"
            ;;
        heart)
            mode_heart "$pin_on" "$pin_off" >/dev/null 2>&1 &
            echo $! > "$PID_DIR/${name}.pid"
            ;;
        disko)
            mode_disko "$pin_on" "$pin_off" >/dev/null 2>&1 &
            echo $! > "$PID_DIR/${name}.pid"
            ;;
        *)
            usage
            ;;
    esac
}

# LED tunggal: off/on itu steady (tanpa proses latar), heart/disko berkedip.
start_status_mode() {
    local mode="$1" pin="$PIN_STATUS"
    stop_mode status

    case "$mode" in
        off)   set_gpio "$pin" 0 ;;
        on)    set_gpio "$pin" 1 ;;
        heart)
            mode_heart_single "$pin" >/dev/null 2>&1 &
            echo $! > "$PID_DIR/status.pid"
            ;;
        disko)
            mode_disko_single "$pin" >/dev/null 2>&1 &
            echo $! > "$PID_DIR/status.pid"
            ;;
        *)
            usage
            ;;
    esac
}

usage() {
    echo "Usage: $0 {power|lan} {offline|online|heart|disko}" >&2
    echo "       $0 status {off|on|heart|disko}" >&2
    echo "       $0 reset" >&2
    exit 1
}

# ========== MAIN ==========
case "$1" in
    power)  start_mode power "$2" "$PIN_POWER_ON" "$PIN_POWER_OFF" ;;
    lan)    start_mode lan   "$2" "$PIN_LAN_ON" "$PIN_LAN_OFF" ;;
    status) start_status_mode "$2" ;;
    reset|stop)
        # Matikan semua pola LED (termasuk yang tak tercatat) & reset GPIO
        stop_mode power
        stop_mode lan
        stop_mode status
        kill_led_procs
        rm -rf "$PID_DIR"
        ;;
    *)     usage ;;
esac
